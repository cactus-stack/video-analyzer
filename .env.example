# YouTube Analyzer - Environment Variables Example
# Copy this file to .env.local and fill in your values

# ============================================
# REQUIRED: Gemini API Key
# ============================================
# Get your FREE API key from: https://aistudio.google.com/apikey
# The free tier includes:
#   - 8 hours of video analysis per day
#   - 1,500 grounding requests per day
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# REQUIRED: Authentication Passwords
# ============================================
# Password for friends (shared access, 8 hours/day limit)
# Change this to something secure!
FRIENDS_PASSWORD=amigos123

# Your personal password (unlimited access)
# Keep this secret!
OWNER_PASSWORD=your_secret_password_here

# ============================================
# OPTIONAL: Upstash Redis (for usage tracking)
# ============================================
# Only needed if you want to track usage limits for shared password mode
# Get free Redis at: https://upstash.com
# Or create via Vercel: Dashboard → Storage → Create Database → Upstash Redis
#
# These will be auto-configured if you use Vercel Integration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# DEVELOPMENT ONLY
# ============================================
# These are automatically set by Vercel in production
# You don't need to set them locally
# NEXT_PUBLIC_VERCEL_URL=
# VERCEL_URL=
